{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "management-of-house",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "management-of-house-db",
      "database_id": "DATABASE_ID"
    }
  ]
}
