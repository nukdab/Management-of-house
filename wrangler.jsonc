{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "management-of-house",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-05",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "management-of-house-db",
      "database_id": "58b30614-e4d0-4d98-b817-c6db8a1372a9"
    }
  ]
}
